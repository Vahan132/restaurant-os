# Base URL of the Restaurant OS backend HTTP API
# Path-based prod example: https://msi.tail8514ca.ts.net/res/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Next.js basePath the app is served under (path-based multi-tenant deploy).
# Consumed by BOTH next.config.mjs (basePath/assetPrefix) and the client tenant
# resolver (src/lib/tenant.ts strips it off window.location.pathname to read the
# slug). Leave UNSET to use the default "/res/m". Set to "" for root deployment.
# NEXT_PUBLIC_BASE_PATH=/res/m

# Optional dev override for the restaurant slug. Leave UNSET in the path-based
# deployment — the slug is resolved from the basePath-stripped path (the first
# segment of usePathname(), e.g. /res/m/demo?qr=5 -> "demo").
# NEXT_PUBLIC_RESTAURANT_SLUG=demo
