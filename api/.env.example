# ── Restaurant OS — environment ─────────────────────────────────────────────
# Copy to `.env` and fill in. Validated at boot (zod, fail-fast).

# Runtime
NODE_ENV=development
# Path-based Tailscale deployment listens on 5200 (nginx proxies /res/api -> here).
PORT=5200

# Database (PostgreSQL)
DATABASE_URL="postgresql://restaurantos:restaurantos@localhost:5432/restaurantos?schema=public"

# Redis (Socket.IO adapter for real-time KDS; required from prompt 8 onward)
REDIS_URL="redis://localhost:6379"

# Auth secrets (used from prompt 2 onward; required to be present now)
JWT_ACCESS_SECRET="change-me-access-secret-min-16-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-16-chars"

# CORS — comma-separated list of allowed origins. Use "*" to allow all.
# Behind the single Tailscale host everything is same-origin, but set it anyway.
CORS_ORIGINS="https://msi.tail8514ca.ts.net,http://localhost:3000,http://localhost:5173"

# Platform host used to derive restaurant subdomains. Behind the path-based host
# there is no subdomain, so host resolution falls back to the X-Restaurant-Slug
# header the customer app sends.
PLATFORM_ROOT_DOMAIN="msi.tail8514ca.ts.net"

# Platform (super-admin) auth secrets — MUST differ from the tenant JWT secrets.
PLATFORM_JWT_ACCESS_SECRET="change-me-platform-access-secret-min16"
PLATFORM_JWT_REFRESH_SECRET="change-me-platform-refresh-secret-min16"

# ── Consumer identity (CX-2) ────────────────────────────────────────────────
# Consumer auth is a SEPARATE audience. The access secret MUST differ from the
# tenant + platform secrets. (Refresh tokens are opaque/hash-only; the refresh
# secret is reserved for a future signed-refresh variant.)
CONSUMER_JWT_ACCESS_SECRET="change-me-consumer-access-secret-min16"
CONSUMER_JWT_REFRESH_SECRET="change-me-consumer-refresh-secret-min16"
CONSUMER_ACCESS_TTL_MINUTES=15
CONSUMER_REFRESH_TTL_DAYS=30

# Phone OTP
OTP_TTL_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15
OTP_CODE_LENGTH=6

# Provider audiences (comma-separated client IDs the ID token aud must match).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Nikita SMS gateway. Leave URL/USER/PASS blank in dev → console-stub sender
# prints the OTP code to the server log (OTP works end-to-end without real SMS).
SMS_NIKITA_URL=
SMS_NIKITA_USER=
SMS_NIKITA_PASS=
SMS_NIKITA_ORIGINATOR=
SMS_NIKITA_PRIORITY=0
SMS_NIKITA_TIMEOUT_MS=10000

# ── MEDIA-1: object storage for images ──────────────────────────────────
# STORAGE_DRIVER=dev (default) uses the local filesystem — no cloud creds needed;
# uploads land under MEDIA_DEV_DIR and are served back by the API. Production
# MUST use r2 (enforced at boot), which requires the four R2_* vars below.
STORAGE_DRIVER=dev
# Public base for resolving a stored key → URL (R2 public bucket / CDN domain in
# prod; the dev server base in dev). No trailing slash needed.
STORAGE_PUBLIC_BASE_URL=http://localhost:3001
# Cloudflare R2 (required only when STORAGE_DRIVER=r2). Endpoint is derived as
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Local dir the dev adapter writes/serves objects from (gitignore it).
MEDIA_DEV_DIR=.media-dev
# Presign TTL (seconds) and advisory max upload size (bytes; default 5 MiB).
MEDIA_PRESIGN_TTL_SECONDS=300
MEDIA_MAX_UPLOAD_BYTES=5242880
