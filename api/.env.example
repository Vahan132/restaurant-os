# ── Restaurant OS — environment ─────────────────────────────────────────────
# Copy to `.env` and fill in. Validated at boot (zod, fail-fast).

# Runtime
NODE_ENV=development
# Path-based Tailscale deployment listens on 5200 (nginx proxies /res/api -> here).
PORT=5200

# Database (PostgreSQL)
DATABASE_URL="postgresql://restaurantos:restaurantos@localhost:5432/restaurantos?schema=public"

# Redis (Socket.IO adapter for real-time KDS; required from prompt 8 onward)
REDIS_URL="redis://localhost:6379"

# Auth secrets (used from prompt 2 onward; required to be present now)
JWT_ACCESS_SECRET="change-me-access-secret-min-16-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-16-chars"

# CORS — comma-separated list of allowed origins. Use "*" to allow all.
# Behind the single Tailscale host everything is same-origin, but set it anyway.
CORS_ORIGINS="https://msi.tail8514ca.ts.net,http://localhost:3000,http://localhost:5173"

# Platform host used to derive restaurant subdomains. Behind the path-based host
# there is no subdomain, so host resolution falls back to the X-Restaurant-Slug
# header the customer app sends.
PLATFORM_ROOT_DOMAIN="msi.tail8514ca.ts.net"

# Platform (super-admin) auth secrets — MUST differ from the tenant JWT secrets.
PLATFORM_JWT_ACCESS_SECRET="change-me-platform-access-secret-min16"
PLATFORM_JWT_REFRESH_SECRET="change-me-platform-refresh-secret-min16"
