// Restaurant OS — Prisma schema.
//
// MULTI-TENANCY CONVENTION:
//   Organization (billing/account) -> Restaurant (operations) -> Branch.
//   Operational entities carry restaurantId (indexed) and are tenant-scoped on
//   every query. Platform (super-admin) data is cross-tenant. Money = integer
//   minor units (fields end in _amount); rates = integer basis points.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────
enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum PlanInterval {
  MONTH
  YEAR
}

enum RestaurantStatus {
  ACTIVE
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

// Device-anchored staff auth (3A): how strictly a branch binds logins to its IP
// allowlist. STRICT = the request's real client IP MUST be inside `ipAllowlist`;
// SOFT (default) = record the seen IP and trust it (IP is a secondary signal,
// the enrolled device is the real first factor).
enum BranchIpBindingMode {
  STRICT
  SOFT
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum PlatformUserStatus {
  ACTIVE
  BLOCKED
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
}

enum MenuStatus {
  ACTIVE
  INACTIVE
}

enum ItemAvailability {
  AVAILABLE
  UNAVAILABLE
}

enum PreparationStation {
  KITCHEN
  BAR
  DESSERT
  OTHER
}

enum ModifierSelectionType {
  SINGLE
  MULTIPLE
}

enum ZoneStatus {
  ACTIVE
  INACTIVE
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  DISABLED
}

// ── Account / billing ───────────────────────────────────────────────────────
model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?

  subscription Subscription?
  billingInfo  OrganizationBillingInfo?
  restaurants  Restaurant[]
  users        User[]
  roles        Role[]

  @@map("organizations")
}

model Plan {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  priceAmount Int          @map("price_amount")
  currency    String
  interval    PlanInterval
  features    Json
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([planId])
  @@map("subscriptions")
}

// ── Operations ────────────────────────────────────────────────────────────
model Restaurant {
  id              String           @id @default(cuid())
  organizationId  String
  name            String
  slug            String           @unique
  customDomain    String?          @unique
  currency        String
  defaultLanguage String           @default("en")
  timezone        String           @default("UTC")
  status          RestaurantStatus @default(ACTIVE)
  // OFF-5: per-restaurant token signing root key (64-hex). The cloud and the
  // restaurant's edge hub both sign/verify this restaurant's tokens with it, so
  // a token from either side validates on both. Flows to the edge via the OFF-2
  // snapshot / OFF-3 config (the Restaurant row). NEVER exposed to clients.
  tokenSigningKey String?          @map("token_signing_key")
  // CX-1 (consumer discovery): brand-level marketing profile, inherited by all
  // branches for consumer-app display. i18n is per-column hy/ru/en — a DELIBERATE
  // localized model for consumer-facing copy (the operational catalog stores the
  // primary locale only; see CONVENTIONS). `consumerListingSuppressed` is the
  // platform-admin brand kill switch (read here in CX-1; controlled in CX-ADMIN).
  aboutHy                   String?
  aboutRu                   String?
  aboutEn                   String?
  website                   String?
  consumerListingSuppressed Boolean @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branches        Branch[]
  marketingPhotos     RestaurantPhoto[]
  attributeSelections RestaurantAttribute[]
  users           User[]
  settings        RestaurantSettings?
  menuCategories  MenuCategory[]
  menuItems          MenuItem[]
  modifierGroups     ModifierGroup[]
  modifierOptions    ModifierOption[]
  dishModifierGroups DishModifierGroup[]
  floors          Floor[]
  tables          RestaurantTable[]
  orders          Order[]
  reservations    Reservation[]
  customerOrderRequests CustomerOrderRequest[]
  missedCalls     MissedCall[]
  callDevices     CallDevice[]
  devices         Device[]

  @@index([organizationId])
  @@map("restaurants")
}

model Branch {
  id           String       @id @default(cuid())
  restaurantId String
  name         String
  // BR-9: public-facing, per-restaurant unique slug (QR menu + public booking
  // URLs). Backfilled from the branch name; the default branch gets a clean slug.
  slug         String
  // BR-1: exactly one default branch per restaurant (enforced in code; the
  // make-default use case moves the flag atomically).
  isDefault    Boolean      @default(false)
  status       BranchStatus @default(ACTIVE)
  // Device-anchored staff auth (3A): per-branch IP policy. SOFT by default (IP is
  // a secondary check). `ipAllowlist` holds manager-editable CIDRs; under STRICT
  // a PIN/anchored login is allowed only from a source IP inside the allowlist.
  ipBindingMode BranchIpBindingMode @default(SOFT)
  ipAllowlist   String[]            @default([])
  // ORDER-1: per-branch ordering flow policy (OrderingConfig VO). Flat columns
  // (matches the branch-config convention). NARROWS the restaurant ceiling
  // (RestaurantSettings.enableCustomerOrdering / enableQrMenu) — never widens it;
  // the effective capability is computed at session start.
  orderingPrepaymentEnabled Boolean @default(false)
  orderingPayAtEndEnabled   Boolean @default(false)
  orderingQrEnabled         Boolean @default(false)
  orderingIdleExpiryMinutes Int     @default(150)
  // CX-1 (consumer discovery): the Branch is the consumer "listing unit". Location
  // data is branch-owned here (operational address/phone on RestaurantSettings is
  // restaurant-scoped/single-location, so the consumer context carries its own
  // per-branch public location fields). The three visibility flags are independent;
  // effective listing = listedInConsumerApp && !restaurant.consumerListingSuppressed.
  publicPhone         String?
  address             String?
  city                String?
  menuPublic          Boolean @default(false)
  reservationsPublic  Boolean @default(false)
  listedInConsumerApp Boolean @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  restaurant  Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  memberships BranchMembership[]
  publicHours BranchPublicHours[]
  // CX-3: consumers who saved this branch.
  savedBy     SavedRestaurant[]

  @@unique([restaurantId, slug])
  @@index([listedInConsumerApp])
  @@index([restaurantId])
  @@map("branches")
}

// BR-1: a user's role AT A SPECIFIC BRANCH. The EXISTING restaurant-level
// user->role assignment (User.roleId, unless it is the BRANCH_SCOPED sentinel)
// denotes RESTAURANT-WIDE access. A branch-scoped user (sentinel role) has no
// restaurant-wide role and gains access only through these memberships
// (one role per user per branch).
model BranchMembership {
  id              String   @id @default(cuid())
  restaurantId    String
  branchId        String
  userId          String
  roleId          String
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([branchId, userId])
  @@index([restaurantId, userId])
  @@index([branchId])
  @@map("branch_memberships")
}

model RestaurantSettings {
  id           String  @id @default(cuid())
  restaurantId String  @unique
  logoUrl      String?
  // MEDIA-1: object-storage key for an uploaded logo. Additive + nullable; null ⇒
  // URL-paste (logoUrl) is the source. logoUrl holds the resolved public URL.
  logoKey      String? @map("logo_key")
  phone        String?
  address      String?

  taxRateBps        Int @default(0)
  serviceFeeRateBps Int @default(0)

  receiptFooter String?
  openingHours  Json?

  allowDiscounts                 Boolean @default(true)
  allowOrderCancellation         Boolean @default(true)
  requireApprovalForCancellation Boolean @default(false)
  requireApprovalForDiscount     Boolean @default(false)
  enableReservations             Boolean @default(true)
  enableKds                      Boolean @default(true)
  enableQrMenu                   Boolean @default(true)
  enableCustomerOrdering         Boolean @default(false)
  allowManualTableStatus         Boolean @default(false)
  // Device-anchored staff auth (3A): when false (default), an admin/manager
  // email+password login must come from an enrolled ADMIN-surface device. When
  // true, admin login is allowed from any device. The Owner is always exempt
  // (break-glass), regardless of this toggle.
  allowUnanchoredAdminLogin      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_settings")
}

// ── Identity ──────────────────────────────────────────────────────────────
model User {
  id             String     @id @default(cuid())
  organizationId String
  restaurantId   String?
  branchId       String?
  email          String
  passwordHash   String
  fullName       String
  status         UserStatus @default(ACTIVE)
  roleId         String
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant        Restaurant?        @relation(fields: [restaurantId], references: [id])
  role              Role               @relation(fields: [roleId], references: [id])
  refreshTokens     RefreshToken[]
  branchMemberships BranchMembership[]
  staffPin          StaffPin?

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([restaurantId])
  @@index([roleId])
  @@map("users")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  permissions    String[]
  isSystem       Boolean  @default(false)
  // FIX-E: ALL-BRANCH reach as a role capability (only OWNER true by default).
  // Separate from restaurant-wide permissions; staff stay branch-explicit.
  allBranches    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ── Device-anchored staff auth (3A) ─────────────────────────────────────────
enum DeviceSurface {
  POS
  KDS
  ADMIN
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum StaffPinStatus {
  ACTIVE
  REVOKED
}

// An enrolled in-store device — the REAL first factor of staff auth. Possession
// of its secret is required for every PIN login (POS/KDS) and for anchored
// ADMIN-surface dashboard login. Only sha256(secret) is stored; the plaintext
// secret is returned exactly once at enrollment. Branch-scoped.
model Device {
  id               String        @id @default(cuid())
  restaurantId     String
  branchId         String
  label            String
  surface          DeviceSurface
  // sha256(secret) — deterministic so the secret can be looked up O(1) on login
  // (mirrors CallDevice.tokenHash). The secret is high-entropy random, so a fast
  // hash is appropriate here; low-entropy PINs use argon2 instead (see StaffPin).
  deviceSecretHash String        @unique
  enrolledByUserId String
  enrolledIp       String?
  enrolledCidr     String?
  status           DeviceStatus  @default(ACTIVE)
  lastSeenAt       DateTime?
  lastSeenIp       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, branchId])
  @@index([restaurantId, branchId, surface, status])
  @@map("devices")
}

// A staff member's PIN (one row per user). The PIN is hashed with argon2
// (`pinHash`); a separate keyed fingerprint (`pinFingerprint` =
// HMAC(per-restaurant key, pin)) enforces "active PIN is unique within a
// restaurant" without storing or revealing the PIN. On revoke, the fingerprint
// is nulled so the active-uniqueness constraint frees that value (NULLs are
// distinct in Postgres). Per-user rate-limit + lockout live on this row.
model StaffPin {
  id              String         @id @default(cuid())
  userId          String         @unique
  restaurantId    String
  pinHash         String
  pinFingerprint  String?
  status          StaffPinStatus @default(ACTIVE)
  failedAttempts  Int            @default(0)
  lockedUntil     DateTime?
  mustRotate      Boolean        @default(false)
  createdByUserId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Active-PIN uniqueness within a restaurant (revoked rows have a null
  // fingerprint and so never collide).
  @@unique([restaurantId, pinFingerprint])
  @@index([restaurantId])
  @@map("staff_pins")
}

// Manager step-up discounts (4A): DEVICE-scoped rate-limit + lockout on failed
// step-up authorization attempts. One row per enrolled device. This is purely a
// throttle (no secrets) and is edge-LOCAL operational state — it is intentionally
// NOT captured in the sync outbox (a brute-force lockout is a per-node concern).
// Distinct from StaffPin.lockedUntil, which is the per-USER PIN lockout owned by
// the 3A primitive.
model StepUpThrottle {
  id             String    @id @default(cuid())
  // The enrolled device the step-up attempts originate from (Device.id). Unique:
  // one throttle row per device.
  deviceId       String    @unique
  restaurantId   String
  branchId       String
  failedAttempts Int       @default(0)
  // When set + in the future, the device's step-up is locked until this instant.
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([restaurantId, branchId])
  @@map("step_up_throttles")
}

// ── Platform (cross-tenant) ─────────────────────────────────────────────────
model PlatformUser {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  fullName     String
  role         PlatformRole       @default(SUPER_ADMIN)
  status       PlatformUserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  refreshTokens PlatformRefreshToken[]

  @@map("platform_users")
}

model PlatformRefreshToken {
  id             String    @id @default(cuid())
  platformUserId String
  tokenHash      String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@map("platform_refresh_tokens")
}

// ── Menu (tenant-scoped by restaurantId) ─────────────────────────────────────
model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  // BR-2: catalog is branch-owned (clone-and-diverge). branchId is denormalised
  // onto every menu row for clean scoping + integrity (plain scalar, like other
  // branch-scoped tables). `code` is the stable per-branch identity (import key).
  branchId     String
  code         String
  name         String
  description  String?
  displayOrder Int        @default(0)
  status       MenuStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@unique([restaurantId, branchId, code])
  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@map("menu_categories")
}

model MenuItem {
  id                 String             @id @default(cuid())
  restaurantId       String
  branchId           String
  code               String
  categoryId         String
  name               String
  description        String?
  priceAmount        Int                @map("price_amount")
  imageUrl           String?
  // MEDIA-1: object-storage key for an uploaded image (R2/dev). Additive + nullable;
  // null ⇒ URL-paste (imageUrl) is the source. imageUrl holds the resolved public URL.
  imageKey           String?            @map("image_key")
  preparationStation PreparationStation @default(KITCHEN)
  prepTimeMinutes    Int?
  status             MenuStatus         @default(ACTIVE)
  availability       ItemAvailability   @default(AVAILABLE)
  // CATALOG-3 §9: hides the customer ingredient list (NOT the allergen summary).
  // Additive, default false; safe on existing rows.
  hideRecipe         Boolean            @default(false)
  // FISCAL-0: the dish-level SRC ATG classifier code for fiscalization. The ATG
  // code belongs to the SOLD product (the dish), not its ingredients (whose
  // catalog adgCodes are commodity/HS codes), so it lives here and is snapshotted
  // onto OrderItem.adgCode at order-build time. Nullable/additive: null = not yet
  // classified (FISCAL-1 fail-closes the fiscal print on a null line, error 192).
  adgCode            String?            @map("adg_code")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  restaurant         Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category           MenuCategory        @relation(fields: [categoryId], references: [id])
  // Prompt 1A: dishes link to reusable modifier groups via the join table.
  modifierGroupLinks DishModifierGroup[]

  @@unique([restaurantId, branchId, code])
  @@index([restaurantId])
  @@index([categoryId])
  @@index([restaurantId, branchId])
  @@map("menu_items")
}

// Modifier groups are a reusable, restaurant+branch-scoped LIBRARY (Prompt 1A).
// They are no longer owned by a single dish; a group is attached to any number of
// dishes many-to-many via DishModifierGroup. (Was: per-dish `menuItemId`.)
model ModifierGroup {
  id            String                @id @default(cuid())
  restaurantId  String
  // BR-2: branch-scoped library — each branch keeps its own modifier groups.
  branchId      String
  name          String
  selectionType ModifierSelectionType
  required      Boolean               @default(false)
  minSelect     Int?
  maxSelect     Int?
  status        MenuStatus            @default(ACTIVE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  options    ModifierOption[]
  dishLinks  DishModifierGroup[]

  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@map("modifier_groups")
}

model ModifierOption {
  id               String     @id @default(cuid())
  restaurantId     String
  modifierGroupId  String
  name             String
  priceDeltaAmount Int        @default(0) @map("price_delta_amount")
  // Renamed displayOrder -> sortOrder (Prompt 1A). isDefault: pre-selected option.
  sortOrder        Int        @default(0)
  isDefault        Boolean    @default(false)
  status           MenuStatus @default(ACTIVE)
  // BR-2: denormalised branch scope (matches the owning group's branch).
  branchId         String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  group      ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([modifierGroupId])
  @@index([restaurantId, branchId])
  @@map("modifier_options")
}

// Dish ↔ ModifierGroup attachment (many-to-many) with optional per-attachment
// overrides. A null override inherits the group's value. No deletedAt: detaching
// removes the row (the link carries no historical data — order lines snapshot
// their own selected modifiers).
model DishModifierGroup {
  id               String   @id @default(cuid())
  restaurantId     String
  branchId         String
  menuItemId       String
  modifierGroupId  String
  requiredOverride Boolean?
  minOverride      Int?
  maxOverride      Int?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  item          MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierGroupId])
  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@index([menuItemId])
  @@index([modifierGroupId])
  @@map("dish_modifier_groups")
}

// ── Tables / floor plan (tenant-scoped by restaurantId) ──────────────────────
model Floor {
  id           String     @id @default(cuid())
  restaurantId String
  // BR-4: operational entities are branch-scoped. branchId is a denormalised
  // plain scalar (no FK back-relation), matching menu/inventory/order_items.
  branchId     String
  name         String
  description  String?
  displayOrder Int        @default(0)
  status       ZoneStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables     RestaurantTable[]

  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@map("floors")
}

model RestaurantTable {
  id           String      @id @default(cuid())
  restaurantId String
  branchId     String
  floorId      String
  name         String
  seatCapacity Int
  status       TableStatus @default(AVAILABLE)
  qrIdentifier String?     @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  floor      Floor      @relation(fields: [floorId], references: [id], onDelete: Cascade)
  orders     Order[]
  reservations Reservation[]
  customerOrderRequests CustomerOrderRequest[]

  @@unique([restaurantId, branchId, name])
  @@index([restaurantId])
  @@index([floorId])
  @@index([restaurantId, branchId])
  @@map("restaurant_tables")
}

// ── Orders (core; tenant-scoped by restaurantId) — NO TAX ────────────────────
enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  DRAFT
  SENT_TO_KITCHEN
  PREPARING
  READY
  SERVED
  CLOSED
  CANCELLED
}

enum OrderItemStatus {
  NEW
  SENT
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum DiscountType {
  PERCENT
  FIXED
}

// Gapless per-restaurant order numbering.
model OrderCounter {
  restaurantId String @id
  lastNumber   Int    @default(0)

  @@map("order_counters")
}

model Order {
  id           String      @id @default(cuid())
  restaurantId String
  // BR-4: the branch the order was taken at. Immutable after creation; payments,
  // splits, and stock consumption all inherit it.
  branchId     String
  orderNumber  Int
  type         OrderType   @default(DINE_IN)
  tableId      String?
  // ORDER-1: nullable ordering-container link. ORDER-2 lifts this into the Order
  // aggregate so a QR-web prepayment order can be attached to a PREPAYMENT session.
  tableSessionId String?
  // ORDER-2: nullable — a QR-web (customer-placed) order has no waiter. Staff
  // (POS) orders always carry one; null carries "customer-placed" semantics.
  waiterId     String?
  // ORDER-4: the consumer (CX-2) who placed this order via the app. Nullable +
  // SetNull — QR-web/staff orders stay null; set only on the app prepayment path.
  // Deleting a CustomerAccount severs the link without deleting order history.
  consumerId   String?
  status       OrderStatus @default(DRAFT)
  currency     String

  subtotalAmount          Int           @default(0) @map("subtotal_amount")
  discountType            DiscountType?
  discountValue           Int?
  discountAmount          Int           @default(0) @map("discount_amount")
  discountApprovedByUserId String?
  serviceFeeAmount        Int           @default(0) @map("service_fee_amount")
  totalAmount             Int           @default(0) @map("total_amount")

  paymentStatus    PaymentStatus @default(UNPAID) @map("payment_status")
  paidAmount       Int           @default(0) @map("paid_amount")
  splitFromOrderId String?       @map("split_from_order_id")

  // ORDER-2: fiscal-aware tender split (integer minor units; QR v1: card only).
  cardAmount       Int     @default(0) @map("card_amount")
  cashAmount       Int     @default(0) @map("cash_amount")
  partialAmount    Int     @default(0) @map("partial_amount")
  prePaymentAmount Int     @default(0) @map("prepayment_amount")
  changeAmount     Int     @default(0) @map("change_amount")
  // Buyer TIN for a partner receipt (out of scope v1 — reserved nullable).
  partnerTin       String? @map("partner_tin")
  // PaymentPort charge reference (traceability; supports idempotent re-confirm).
  paymentReference String? @map("payment_reference")
  // ORDER-2: fiscal result, null until fiscalised (recoverable paid-but-
  // unfiscalized state = paymentStatus PAID with these null, pending retry).
  fiscalReceiptId  String?   @map("fiscal_receipt_id")
  fiscalNumber     String?   @map("fiscal_number")
  fiscalQr         String?   @map("fiscal_qr")
  fiscalizedAt     DateTime? @map("fiscalized_at")
  // FISCAL-0: fatal-config fiscal error marker (SRC code, e.g. "192"/"403");
  // null = no fatal error. Set when fiscalization returns a fatal-config
  // classification so a retried ConfirmPayment stops the retry loop and the
  // operator can see why; cleared on fiscal success (applyFiscalResult).
  fiscalError      String?   @map("fiscal_error")

  note                  String?
  cancelledReason       String?
  cancelledByUserId     String?
  cancelApprovedByUserId String?
  closedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table        RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableSession TableSession?    @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  consumer     CustomerAccount? @relation(fields: [consumerId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  payments     Payment[]

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId])
  @@index([tableId])
  @@index([tableSessionId])
  @@index([consumerId])
  @@index([status])
  @@index([restaurantId, branchId])
  @@index([restaurantId, branchId, status])
  @@map("orders")
}

// ── Table sessions (ORDER-1; ordering container, tenant-scoped) ───────────────
enum TableSessionState {
  PENDING_CONFIRM
  OPEN
  LOCKED
  CLOSED
  EXPIRED
}

enum TableSessionFlow {
  PREPAYMENT
  PAY_AT_END
}

enum TableSessionChannel {
  QR_WEB
  APP
}

/// The ordering CONTAINER for a (branch, table). branchId/tableId are
/// denormalised scalars (BR-4, no FK back-relation), matching orders/inventory.
model TableSession {
  id                String              @id @default(cuid())
  restaurantId      String
  branchId          String
  tableId           String
  state             TableSessionState
  flow              TableSessionFlow
  channel           TableSessionChannel
  // Opaque reattach token — SHA-256 only; plaintext returned once at creation.
  tokenHash         String
  // App participant who opened the session (null for anonymous QR-web).
  consumerAccountId String?
  openedAt          DateTime            @default(now())
  lastActivityAt    DateTime            @default(now())
  closedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  orders Order[]

  // NOTE: "at most one NON-TERMINAL session per (branch, table)" is enforced by a
  // PARTIAL UNIQUE INDEX created in raw SQL in the migration — Prisma cannot
  // express filtered indexes: UNIQUE ("branchId","tableId") WHERE "state" IN
  // ('PENDING_CONFIRM','OPEN','LOCKED'). Preserve it on future migrations.
  @@index([branchId, tableId])
  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@index([tableId])
  @@index([state])
  @@index([lastActivityAt])
  @@map("table_sessions")
}

model OrderItem {
  id                 String             @id @default(cuid())
  restaurantId       String
  branchId           String
  orderId            String
  menuItemId         String
  nameSnapshot       String
  unitPriceAmount    Int                @map("unit_price_amount")
  preparationStation PreparationStation
  quantity           Int
  note               String?
  status             OrderItemStatus    @default(NEW)
  lineTotalAmount    Int                @default(0) @map("line_total_amount")
  sentToKitchenAt    DateTime?
  preparingAt        DateTime?
  readyAt            DateTime?
  cancelledReason    String?
  // ORDER-2 fiscal-ready line fields. Populated for QR-web lines (goodCode/
  // goodName/unit); null for POS lines until the catalog carries them.
  goodCode           String?            @map("good_code")
  goodName           String?            @map("good_name")
  unit               String?
  // RESERVED (fiscal-ready, no logic in v1): ATG/department + SRC discount codes +
  // marked-goods emarks. Sourced in catalog / roadmap #6.
  adgCode                String?        @map("adg_code")
  dep                    String?
  discount               Int?
  discountType           Int?           @map("line_discount_type")
  additionalDiscount     Int?           @map("additional_discount")
  additionalDiscountType Int?           @map("additional_discount_type")
  emarks                 String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@map("order_items")
}

model OrderItemModifier {
  id               String  @id @default(cuid())
  orderItemId      String
  modifierGroupId  String?
  modifierOptionId String?
  nameSnapshot     String
  priceDeltaAmount Int     @map("price_delta_amount")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentState {
  ACTIVE
  VOIDED
}

model Payment {
  id           String        @id @default(cuid())
  restaurantId String
  branchId     String
  orderId      String
  method       PaymentMethod
  amount       Int
  tenderedAmount Int?        @map("tendered_amount")
  state        PaymentState  @default(ACTIVE)
  // ORDER-2: nullable — a gateway-processed QR prepayment has no staff user.
  processedByUserId String?
  voidedByUserId    String?
  voidedReason      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@map("payments")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ARRIVED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// How a reservation entered the system. STAFF = created in the back office;
// PUBLIC = self-service request-to-book; PHONE = created from a missed call.
enum ReservationSource {
  STAFF
  PUBLIC
  PHONE
}

model Reservation {
  id              String            @id @default(cuid())
  restaurantId    String
  branchId        String
  customerName    String
  customerPhone   String
  customerEmail   String?
  guestCount      Int
  reservedAt      DateTime
  durationMinutes Int               @default(90)
  tableId         String?
  status          ReservationStatus @default(PENDING)
  source          ReservationSource @default(STAFF)
  notes           String?
  customerNote    String?
  arrivedAt       DateTime?
  seatedAt        DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelledReason String?
  createdByUserId String
  // Consumer (CX-2) who booked, if this reservation came from the consumer app.
  // Nullable + SetNull: deleting a CustomerAccount severs the link (delete-account
  // also anonymizes the denormalized customer* PII below in the same operation).
  // CX-3 populates this when a consumer creates a booking.
  consumerId      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  consumer   CustomerAccount? @relation(fields: [consumerId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([tableId])
  @@index([reservedAt])
  @@index([consumerId])
  @@index([restaurantId, branchId, reservedAt])
  @@map("reservations")
}

enum MissedCallStatus {
  NEW
  HANDLED
  DISMISSED
}

// A missed call ingested from a registered Android companion device. Recording a
// missed call is always allowed (it is just a log); creating a reservation from
// one is gated by RestaurantSettings.enableReservations. Idempotent on
// (restaurantId, dedupeKey).
model MissedCall {
  id                 String           @id @default(cuid())
  restaurantId       String
  branchId           String
  deviceId           String
  phoneNumber        String
  callerName         String?
  occurredAt         DateTime
  status             MissedCallStatus @default(NEW)
  handledByUserId    String?
  linkedReservationId String?
  dedupeKey          String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  device     CallDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dedupeKey])
  @@index([restaurantId, status, occurredAt])
  @@index([deviceId])
  @@index([restaurantId, branchId, status, occurredAt])
  @@map("missed_calls")
}

enum CallDeviceStatus {
  ACTIVE
  REVOKED
}

// A registered Android companion that ingests missed calls. Authenticates with a
// bearer device token; only the sha256 hash of that token is stored.
model CallDevice {
  id              String           @id @default(cuid())
  restaurantId    String
  branchId        String
  name            String
  tokenHash       String           @unique
  status          CallDeviceStatus @default(ACTIVE)
  lastSeenAt      DateTime?
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  restaurant  Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  missedCalls MissedCall[]

  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@map("call_devices")
}

enum AuditActorType {
  USER
  PLATFORM_USER
  SYSTEM
}

model AuditLog {
  id             String         @id @default(cuid())
  organizationId String?
  restaurantId   String?
  // Branch the audited action occurred in (null for restaurant/org-level actions
  // with no branch context). Drives the branch-scoped activity-log view.
  branchId       String?
  actorType      AuditActorType
  actorId        String?
  actorName      String?
  // Snapshot of the actor's role CODE at the time of the action (e.g. OWNER,
  // MANAGER, WAITER). Null for SYSTEM/PLATFORM actors or custom (non-system)
  // roles. Enables filtering activity by role.
  actorRoleCode  String?
  action         String
  entityType     String
  entityId       String
  oldValue       Json?
  newValue       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime       @default(now())

  @@index([restaurantId, createdAt])
  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  // Activity-log filtered view: branch-scoped reads + action-type filtering.
  @@index([restaurantId, branchId, createdAt])
  @@index([restaurantId, action, createdAt])
  @@map("audit_logs")
}

enum CustomerOrderRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model CustomerOrderRequest {
