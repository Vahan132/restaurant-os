  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model OrganizationBillingInfo {
  id             String   @id @default(cuid())
  organizationId String   @unique
  billingName    String?
  billingEmail   String?
  billingAddress String?
  taxId          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_billing_info")
}

// ── Inventory / warehouse (tenant-scoped by restaurantId, optional branchId) ──
//   Raw AND processed goods, FIFO/FEFO stock layers, and an append-only movement
//   ledger (source of truth for on-hand qty). ALL quantities are integers in the
//   item's base unit. Money = integer minor units (columns end in _amount).
//   These tables intentionally carry restaurantId as a plain indexed column (no
//   FK back-relation on Restaurant), matching order_items / audit_logs.
enum ItemKind {
  RAW
  PROCESSED
}

enum InventoryBaseUnit {
  GRAM
  MILLILITER
  PIECE
}

enum InventoryItemStatus {
  ACTIVE
  INACTIVE
}

enum StockLayerStatus {
  OPEN
  DEPLETED
}

enum StockMovementType {
  RECEIPT_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  CONSUMPTION_OUT
  WRITE_OFF_OUT
  PROCESS_OUT
  PROCESS_IN
  CONSUMPTION_REVERSAL
  // 6A multi-location: OPENING seeds a brand-new (item, location) balance with no
  // prior movement history; TRANSFER_OUT/TRANSFER_IN are reserved for 6B (the
  // endpoints land later, but the ledger types are defined now per §1).
  OPENING
  TRANSFER_OUT
  TRANSFER_IN
}

enum ProcessStatus {
  ACTIVE
  INACTIVE
}

// ── 6A multi-location inventory ──────────────────────────────────────────────
// Physical, branch-scoped stock locations ("shelves"). Three system locations
// (KITCHEN / BAR / MAIN_STORAGE) are seeded per branch; managers add CUSTOM ones.
enum InventoryLocationType {
  KITCHEN
  BAR
  MAIN_STORAGE
  CUSTOM
}

enum InventoryLocationStatus {
  ACTIVE
  ARCHIVED
}

// Per-branch negative-stock policy. WARN = permit-but-flag (default per §4).
enum NegativeStockMode {
  ALLOW
  WARN
  BLOCK
}

enum LowStockAlertStatus {
  OPEN
  RESOLVED
}

model InventoryItem {
  id                    String              @id @default(cuid())
  restaurantId          String
  // BR-3: inventory catalog is branch-owned. sku is the per-branch import key.
  branchId              String
  name                  String
  sku                   String?
  categoryId            String?
  kind                  ItemKind            @default(RAW)
  baseUnit              InventoryBaseUnit
  alternateUnits        Json                @default("[]")
  trackExpiry           Boolean             @default(false)
  lowStockThresholdBase Int?
  lastUnitCostMicro     BigInt?             @map("last_unit_cost_micro")
  // 6C: the location this item is depleted from on serve (per item, per branch).
  // Null => resolve to the branch's default Main Storage (the resolver helper).
  consumptionLocationId String?
  status                InventoryItemStatus @default(ACTIVE)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?

  // ── CATALOG-1: platform-catalog adoption + per-branch overrides ─────────────
  // Additive + nullable so every existing item stays valid. `catalogItemId` is a
  // PLAIN scalar (no FK / no Prisma relation) — the same cross-aggregate style
  // used for itemId/restaurantId across inventory, and it enforces ADR §4: the
  // platform catalog editor has NO ORM path back to tenant inventory ("curate the
  // template, never inspect the tenants"). null = a custom, uncatalogued item;
  // set = adopted from the catalog (always persisted when catalog-sourced).
  // Allergens/adgCode resolve BY REFERENCE (ADR §3): override → catalog (via
  // catalogItemId) → null; the catalog stays the authority — NO denormalized copy
  // is stored here. `allergenOverride`: null = defer to the catalog; a JSON array
  // of allergen slugs = authoritative override (may be [] to assert "no allergens").
  catalogItemId    String?
  allergenOverride Json?    @map("allergen_override")
  adgCodeOverride  String?  @map("adg_code_override")

  @@unique([restaurantId, branchId, sku])
  @@index([restaurantId])
  @@index([branchId])
  @@index([restaurantId, categoryId])
  @@index([restaurantId, branchId])
  @@index([catalogItemId])
  @@map("inventory_items")
}

model InventoryCategory {
  id           String    @id @default(cuid())
  restaurantId String
  branchId     String
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@map("inventory_categories")
}

model Supplier {
  id           String    @id @default(cuid())
  restaurantId String
  branchId     String
  name         String
  contact      String?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@map("inventory_suppliers")
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  restaurantId    String
  branchId        String
  supplierId      String?
  reference       String?
  receivedAt      DateTime
  note            String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines GoodsReceiptLine[]

  @@index([restaurantId])
  @@index([branchId])
  @@index([supplierId])
  @@index([restaurantId, branchId])
  @@index([restaurantId, receivedAt])
  @@map("inventory_goods_receipts")
}

model GoodsReceiptLine {
  id                  String    @id @default(cuid())
  receiptId           String
  branchId            String
  itemId              String
  enteredUnit         String
  enteredQty          Int
  baseQty             Int
  lineTotalCostAmount Int       @map("line_total_cost_amount")
  expiryDate          DateTime?

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([itemId])
  @@index([branchId])
  @@map("inventory_goods_receipt_lines")
}

model StockLayer {
  id                  String           @id @default(cuid())
  restaurantId        String
  // BR-3: branchId always equals the layer's item's branch (set by the service,
  // never the request). Stock attribution follows the item.
  branchId            String
  // 6A: the physical location this lot sits on. Backfilled to the branch's
  // Main Storage by the migration; required thereafter. FIFO `acquiredAt` =
  // `receivedAt` (arrival-at-location semantics, §5).
  locationId          String
  itemId              String
  sourceReceiptLineId String?
  baseQtyReceived     Int
  baseQtyRemaining    Int
  lineTotalCostAmount Int              @map("line_total_cost_amount")
  receivedAt          DateTime
  expiryDate          DateTime?
  status              StockLayerStatus @default(OPEN)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([restaurantId, itemId, receivedAt])
  @@index([restaurantId, itemId, expiryDate])
  @@index([restaurantId, itemId, status])
  @@index([restaurantId, branchId])
  @@index([restaurantId, branchId, itemId, status])
  // 6A: per-(item, location) FIFO scan, oldest arrival first.
  @@index([locationId, itemId, status, receivedAt], map: "inv_stock_layer_loc_item_status_recv_idx")
  @@map("inventory_stock_layers")
}

model StockMovement {
  id              String            @id @default(cuid())
  restaurantId    String
  // BR-3: branchId always equals the moved item's branch (set by the service).
  branchId        String
  // 6A: the location this movement applies to. Drawn from the source layer for
  // OUT movements; the branch default (Main Storage) for shortfalls/seeding.
  // Backfilled to Main Storage by the migration; required thereafter.
  locationId      String
  itemId          String
  type            StockMovementType
  baseQty         Int
  costAmount      Int               @map("cost_amount")
  layerId         String?
  reason          String?
  refType         String?
  refId           String?
  occurredAt      DateTime
  createdByUserId String
  createdAt       DateTime          @default(now())
  /// Set on an OUT movement once it has been reversed (INV-3). Reversal movements
  /// themselves are never reversed (stay null).
  reversedAt      DateTime?

  @@index([restaurantId, itemId, occurredAt])
  @@index([restaurantId, type, occurredAt])
  @@index([restaurantId, refType, refId])
  @@index([restaurantId, branchId])
  // Explicit short map: the default name (69 chars) exceeds Postgres's 63-char
  // identifier limit and would be silently truncated, causing migrate drift.
  @@index([restaurantId, branchId, itemId, occurredAt], map: "inv_stock_mov_rest_branch_item_occurred_idx")
  // 6A: rebuild StockOnHand per (item, location) by summing baseQty.
  @@index([locationId, itemId], map: "inv_stock_mov_loc_item_idx")
  @@map("inventory_stock_movements")
}

// ── 6A multi-location: locations, on-hand projection, policy, alerts ─────────
// Physical, branch-scoped shelf. System locations (KITCHEN/BAR/MAIN_STORAGE)
// cannot be deleted; CUSTOM ones only when they hold no stock. Exactly one
// isDefault per branch (Main Storage) — enforced in the application layer.
model InventoryLocation {
  id           String                  @id @default(cuid())
  restaurantId String
  branchId     String
  name         String
  systemType   InventoryLocationType   @default(CUSTOM)
  isDefault    Boolean                 @default(false)
  status       InventoryLocationStatus @default(ACTIVE)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  deletedAt    DateTime?

  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@index([restaurantId, branchId, systemType])
  @@map("inventory_locations")
}

// Denormalized on-hand per (item, location), maintained in the SAME transaction
// as every ledger append (§4). Rebuildable from the ledger (sum baseQty grouped
// by location+item). `quantity` may be negative. Optional per-location low-stock
// threshold override; falls back to InventoryItem.lowStockThresholdBase.
model StockOnHand {
  id                    String   @id @default(cuid())
  restaurantId          String
  branchId              String
  itemId                String
  locationId            String
  quantity              Int      @default(0)
  lowStockThresholdBase Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([itemId, locationId], map: "inv_on_hand_item_location_key")
  @@index([restaurantId, branchId])
  @@index([restaurantId, branchId, locationId])
  @@map("inventory_stock_on_hand")
}

// One row per branch. Governs what happens when a depletion would drive on-hand
// below zero (§5). Default WARN. (BLOCK applies to manual/admin depletions only;
// the POS-serve exception is enforced in 6C.)
model BranchInventoryPolicy {
  id                String            @id @default(cuid())
  restaurantId      String
  branchId          String
  negativeStockMode NegativeStockMode @default(WARN)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([restaurantId, branchId], map: "inv_branch_policy_rest_branch_key")
  @@index([restaurantId])
  @@map("inventory_branch_policies")
}

// Pre-zero low-stock flag, raised when on-hand at a location crosses at/below the
// threshold while still >= 0 (§5), resolved when it rises back above. At most one
// OPEN alert per (item, location) — enforced in the application/gateway layer.
model LowStockAlert {
  id            String              @id @default(cuid())
  restaurantId  String
  branchId      String
  itemId        String
  locationId    String
  thresholdBase Int
  onHandBase    Int
  status        LowStockAlertStatus @default(OPEN)
  raisedAt      DateTime            @default(now())
  resolvedAt    DateTime?

  @@index([restaurantId, branchId, status])
  @@index([restaurantId, branchId, itemId, locationId, status], map: "inv_low_stock_alert_scope_idx")
  @@map("inventory_low_stock_alerts")
}

// ── 6B within-branch stock transfers ─────────────────────────────────────────
// Relocates stock between two InventoryLocations of the SAME branch at carrying
// cost (no COGS). Reuses StockMovement (TRANSFER_OUT/TRANSFER_IN) + StockLayer;
// the slice rows record consumed-source-layer → cost → qty for auditability.
model InventoryTransfer {
  id                String   @id @default(cuid())
  restaurantId      String
  branchId          String
  itemId            String
  fromLocationId    String
  toLocationId      String
  quantity          Int
  performedByUserId String
  occurredAt        DateTime
  createdAt         DateTime @default(now())

  slices InventoryTransferSlice[]

  @@index([restaurantId, branchId])
  @@index([restaurantId, branchId, itemId])
  @@index([restaurantId, branchId, occurredAt])
  @@map("inventory_transfers")
}

model InventoryTransferSlice {
  id                 String  @id @default(cuid())
  transferId         String
  itemId             String
  // The source lot the slice was drawn from (null only for a defensive shortfall).
  sourceLayerId      String?
  // The destination lot the slice landed in (same unit cost preserved).
  destinationLayerId String
  baseQty            Int
  costAmount         Int     @map("cost_amount")
  unitCostMicro      BigInt  @map("unit_cost_micro")

  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@map("inventory_transfer_slices")
}

// ── Inventory processes / production (INV-2) ─────────────────────────────────
//   A process turns raw/processed inputs into one or more PROCESSED outputs. A
//   run consumes inputs FIFO/FEFO (reusing the StockLayer/StockMovement ledger),
//   rolls input cost + a processing cost into the produced processed-item layers,
//   and links produced layers/movements via refType="PROCESS_RUN", refId=run.id.
model Process {
  id                  String        @id @default(cuid())
  restaurantId        String
  branchId            String
  name                String
  processingCostAmount Int          @default(0) @map("processing_cost_amount")
  note                String?
  status              ProcessStatus @default(ACTIVE)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  inputs  ProcessInput[]
  outputs ProcessOutput[]

  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@map("inventory_processes")
}

model ProcessInput {
  id        String @id @default(cuid())
  processId String
  branchId  String
  itemId    String
  baseQty   Int

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@index([itemId])
  @@index([branchId])
  @@map("inventory_process_inputs")
}

model ProcessOutput {
  id           String  @id @default(cuid())
  processId    String
  branchId     String
  itemId       String
  baseQty      Int
  isPrimary    Boolean @default(false)
  costShareBps Int?

  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@index([itemId])
  @@index([branchId])
  @@map("inventory_process_outputs")
}

model ProcessRun {
  id                   String   @id @default(cuid())
  restaurantId         String
  branchId             String
  processId            String
  multiplier           Int      @default(1)
  inputCostAmount      Int      @map("input_cost_amount")
  processingCostAmount Int      @map("processing_cost_amount")
  totalCostAmount      Int      @map("total_cost_amount")
  wentNegative         Boolean  @default(false)
  runAt                DateTime
  note                 String?
  createdByUserId      String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([restaurantId, processId, runAt])
  @@index([restaurantId, branchId])
  @@map("inventory_process_runs")
}

// ── Consumer discovery (CX-1) ────────────────────────────────────────────────
//   Backend for the consumer-facing discovery + reservation app. Listing unit is
//   the Branch (location fields live on Branch above); brand identity (name on
//   Restaurant, logo on RestaurantSettings, about/website/gallery/attributes) is
//   inherited from the parent Restaurant for display. i18n is per-column hy/ru/en
//   for these consumer-facing tables (a deliberate localized model; the
//   operational catalog stores the primary locale only). Read API is anonymous.

// Platform-defined taxonomy. Restaurants SELECT values; the same taxonomy powers
// the Filters sheet and the detail "Features" list. Attribute selection is stored
// at Restaurant level for v1.
// FUTURE: per-branch attribute override (deferred — do not build in CX-1).
model AttributeCategory {
  id           String           @id @default(cuid())
  slug         String           @unique
  labelHy      String
  labelRu      String
  labelEn      String
  position     Int              @default(0)
  isFilterable Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  values AttributeValue[]

  @@index([position])
  @@map("consumer_attribute_categories")
}

model AttributeValue {
  id         String   @id @default(cuid())
  categoryId String
  slug       String
  labelHy    String
  labelRu    String
  labelEn    String
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category   AttributeCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  selections RestaurantAttribute[]

  // slug unique WITHIN a category.
  @@unique([categoryId, slug])
  @@index([categoryId, position])
  @@map("consumer_attribute_values")
}

// Join: a restaurant's selected attribute values (brand-level for v1).
model RestaurantAttribute {
  restaurantId     String
  attributeValueId String
  createdAt        DateTime @default(now())

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  value      AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([restaurantId, attributeValueId])
  // For filter queries (find restaurants having a given value).
  @@index([attributeValueId])
  @@map("consumer_restaurant_attributes")
}

// Brand photo gallery (Restaurant-scoped). URLs are set by admin (CX-ADMIN);
// CX-1 only models + reads them. `url` is validated as a parseable https URL in
// the domain. alt text is per-column i18n.
model RestaurantPhoto {
  id           String   @id @default(cuid())
  restaurantId String
  position     Int      @default(0)
  url          String
  // MEDIA-1: object-storage key for an uploaded photo. Additive + nullable; null ⇒
  // URL-paste (url) is the source. url holds the resolved public URL either way.
  objectKey    String?  @map("object_key")
  altHy        String?
  altRu        String?
  altEn        String?
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, position])
  @@map("consumer_restaurant_photos")
}

// Per-branch public opening hours (one row per weekday). dayOfWeek: 0=Mon … 6=Sun.
// A closesAt < opensAt means the slot crosses midnight (e.g. 20:00–03:00).
model BranchPublicHours {
  id        String   @id @default(cuid())
  branchId  String
  dayOfWeek Int
  isClosed  Boolean  @default(false)
  opensAt   String?
  closesAt  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
  @@map("consumer_branch_public_hours")
}

// ── Consumer identity (CX-2) ─────────────────────────────────────────────────
//   Customer accounts for the consumer app: Google / Apple / phone-OTP auth.
//   A SEPARATE audience from ALL staff auth — consumer access tokens are signed
//   with a dedicated platform-level key and carry `aud: consumer`; a consumer
//   token never authorizes a staff/platform route and vice-versa. Refresh tokens
//   rotate as a FAMILY with reuse detection; OTP codes + refresh tokens are
//   stored HASHED only (never plaintext). OTP request rate-limit + verify lockout
//   reuse the staff throttle primitive (ConsumerOtpThrottle, keyed by phone).

enum ConsumerGender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum CustomerIdentityProvider {
  GOOGLE
  APPLE
  PHONE
}

model CustomerAccount {
  id        String          @id @default(cuid())
  name      String?
  // Unique WHERE present (Postgres treats multiple NULLs as distinct).
  email     String?         @unique
  phone     String?         @unique // E.164
  gender    ConsumerGender?
  birthday  DateTime?       @db.Date
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  identities    CustomerIdentity[]
  refreshTokens CustomerRefreshToken[]
  reservations  Reservation[]
  // ORDER-4: orders this consumer placed via the app (SetNull on account delete).
  orders        Order[]
  // CX-3: branches this consumer has saved (per-branch bookmark).
  savedRestaurants SavedRestaurant[]

  @@map("customer_accounts")
}

// CX-3: a consumer's saved (bookmarked) branch. The Branch is the listing unit
// (see CX-1), so "saved restaurant" is keyed to a branch. Both FKs cascade: a
// deleted account or branch removes the bookmark. Unique per (account, branch)
// makes save idempotent; the account index serves the "my saved" list.
model SavedRestaurant {
  id                String   @id @default(cuid())
  customerAccountId String
  branchId          String
  createdAt         DateTime @default(now())

  account CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  branch  Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([customerAccountId, branchId])
  @@index([customerAccountId])
  @@map("consumer_saved_restaurants")
}

model CustomerIdentity {
  id                String                   @id @default(cuid())
  customerAccountId String
  provider          CustomerIdentityProvider
  // Provider `sub` (GOOGLE/APPLE) or E.164 phone (PHONE).
  subject           String
  emailVerified     Boolean                  @default(false)
  createdAt         DateTime                 @default(now())

  account CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  // One identity per provider subject; enables find-or-link.
  @@unique([provider, subject])
  @@index([customerAccountId])
  @@map("customer_identities")
}

// Rotating refresh-token family. Only the HASH is stored. Lookup is by tokenHash
// (unique); a presented token whose row is already revoked => reuse => revoke the
// whole family.
model CustomerRefreshToken {
  id                String    @id @default(cuid())
  customerAccountId String
  familyId          String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedById      String?
  createdAt         DateTime  @default(now())

  account CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId])
  @@index([familyId])
  @@map("consumer_refresh_tokens")
}

// A single phone-OTP challenge. Code stored HASHED; short TTL; `attemptCount` is
// per-challenge verify attempts. Request rate-limit + lockout live in
// ConsumerOtpThrottle (the reused primitive), keyed by phone.
model PhoneOtp {
  id           String    @id @default(cuid())
  phone        String // E.164
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([phone])
  @@map("consumer_phone_otps")
}

// OTP rate-limit / lockout state — one row per phone. Clone of the staff
// StepUpThrottle primitive (failedAttempts + lockedUntil), reused for OTP.
model ConsumerOtpThrottle {
  id             String    @id @default(cuid())
  phone          String    @unique // E.164
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("consumer_otp_throttles")
}

// ── Dish recipes / BOM (INV-3) ───────────────────────────────────────────────
//   A recipe links a MENU item (cross-context by id) to the inventory items it
//   consumes per unit sold. Sending an order line to the kitchen consumes them
//   (FIFO); voiding restores them. One recipe per menu item.
model Recipe {
  id           String    @id @default(cuid())
  restaurantId String
  branchId     String
  menuItemId   String
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  lines                RecipeLine[]
  modifierConsumptions ModifierConsumption[]

  // One recipe per menu item; naturally per-branch since menu items are
  // branch-scoped (BR-2).
  @@unique([restaurantId, menuItemId])
  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@map("inventory_recipes")
}

model RecipeLine {
  id       String @id @default(cuid())
  recipeId String
  branchId String
  itemId   String
  baseQty  Int

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([itemId])
  @@index([branchId])
  @@map("inventory_recipe_lines")
}

model ModifierConsumption {
  id               String @id @default(cuid())
  restaurantId     String
  branchId         String
  recipeId         String
  modifierOptionId String
  itemId           String
  baseQty          Int

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([restaurantId, branchId])
  // Explicit map: the default name would exceed Postgres's 63-char identifier
  // limit and get silently truncated, causing migrate drift.
  @@index([restaurantId, modifierOptionId], map: "inventory_mod_consumption_restaurant_option_idx")
  @@map("inventory_modifier_consumptions")
}

// ── Platform catalog / allergens (CATALOG-1, ADR §2–§4, §10) ─────────────────
//   Platform-CURATED, multilingual stock-item templates a tenant adopts from
//   (InventoryItem.catalogItemId), so a central allergen/adgCode correction reaches
//   every adopter by REFERENCE. These tables are PLATFORM-OWNED: no org/restaurant/
//   branch column, global slug @unique — mirroring the consumer AttributeCategory/
//   Value taxonomy. There is deliberately NO relation from a CatalogItem back to
//   InventoryItem: the catalog cannot enumerate its adopters (ADR §4 boundary).

// Platform-defined allergen taxonomy — a fixed, seeded reference set (the EU-14).
// CatalogItems tag against it many-to-many. Not tenant-editable.
model Allergen {
  id        String   @id @default(cuid())
  slug      String   @unique
  labelHy   String
  labelRu   String
  labelEn   String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  catalogItems CatalogItemAllergen[]

  @@index([position])
  @@map("catalog_allergens")
}

// Platform-defined catalog category (multilingual). Small taxonomy the curator
// groups CatalogItems under (produce, dairy, meat, pantry…). Not tenant-scoped.
model CatalogCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  labelHy   String
  labelRu   String
  labelEn   String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CatalogItem[]

  @@index([position])
  @@map("catalog_categories")
}

// Archive state for a CatalogItem (CATALOG-2). ARCHIVED items stop appearing in
// curation lists / new adoption, but existing tenant catalogItemId references still
// RESOLVE (getResolution ignores status) so an archive never orphans a tenant.
enum CatalogItemStatus {
  ACTIVE
  ARCHIVED
}

// The curated template a tenant InventoryItem adopts by reference (ADR §2). Carries
// the multilingual name (operational InventoryItem.name is single-locale, so the
// translations must live here) + allergen tag set + category + a default ATG
// classifier (adgCode). All tenant-overridable on the InventoryItem (ADR §3, §10).
model CatalogItem {
  id         String            @id @default(cuid())
  slug       String            @unique
  nameHy     String
  nameRu     String
  nameEn     String
  categoryId String?
  // ORDER-2 ATG classifier default (mandatory for e-HDM fiscalization). Nullable;
  // tenant overrides via InventoryItem.adgCodeOverride. Wiring the effective value
  // into OrderItem.adgCode is a later prompt (dish-level source decision).
  adgCode    String?           @map("adg_code")
  // CATALOG-2 archive (soft-delete): a hard delete would strand tenant references
  // (catalogItemId is a plain scalar with no FK). Curation archives instead.
  status     CatalogItemStatus @default(ACTIVE)
  // CATALOG-3 §Locked-4: platform support flips this true once allergen tagging is complete.
  // Un-reviewed items count as UNVERIFIED at resolve time (verified = catalogSourced && allergensReviewed).
  allergensReviewed Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deletedAt  DateTime?

  category  CatalogCategory?      @relation(fields: [categoryId], references: [id])
  allergens CatalogItemAllergen[]

  @@index([categoryId])
  @@index([status])
  @@map("catalog_items")
}

// Join: a CatalogItem's allergen tag set (many-to-many). Cascade-deletes with
// either side. The authoritative allergen set for an adopted item resolves through
// here (unless the tenant sets InventoryItem.allergenOverride).
model CatalogItemAllergen {
  catalogItemId String
  allergenId    String
  createdAt     DateTime @default(now())

  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  allergen    Allergen    @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@id([catalogItemId, allergenId])
  @@index([allergenId])
  @@map("catalog_item_allergens")
}

// ── Stock write-offs (INV-4) — reason-coded losses + staff meals ─────────────
//   ITEM lines write off an inventory item directly; DISH lines explode a menu
//   item's recipe (reusing INV-3). All draws are WRITE_OFF_OUT movements keyed by
//   refType="WRITE_OFF"; a void reverses them. Append-only except the void stamp.
enum WriteOffReason {
  STAFF_MEAL
  SPOILAGE
  WASTE
  BREAKAGE
  THEFT
  OTHER
}

enum WriteOffLineKind {
  ITEM
  DISH
}

model WriteOff {
  id              String         @id @default(cuid())
  restaurantId    String
  branchId        String
  reason          WriteOffReason
  note            String?
  occurredAt      DateTime
  createdByUserId String
  voidedAt        DateTime?
  voidedByUserId  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  lines WriteOffLine[]

  @@index([restaurantId, occurredAt])
  @@index([restaurantId, reason, occurredAt])
  @@index([restaurantId, branchId])
  @@map("inventory_write_offs")
}

model WriteOffLine {
  id               String           @id @default(cuid())
  writeOffId       String
  branchId         String
  kind             WriteOffLineKind
  itemId           String?
  menuItemId       String?
  enteredUnit      String?
  enteredQty       Int?
  baseQty          Int?
  units            Int?
  modifierOptionIds Json?
  costAmount       Int              @map("cost_amount")

  writeOff WriteOff @relation(fields: [writeOffId], references: [id], onDelete: Cascade)

  @@index([writeOffId])
  @@index([branchId])
  @@map("inventory_write_off_lines")
}

// ── Historical / external sales import (5A) ──────────────────────────────────
//   NON-FISCAL, REPORTS-ONLY sales loaded from external/legacy systems for
//   analytics. Isolation is STRUCTURAL: these rows live in their own tables and
//   are NEVER reachable by the live order pipeline, fiscalization/HDM, or
//   inventory depletion. No FK into orders/payments/stock — by construction they
//   cannot enter any fiscal total. Branch-scoped like every operational entity.
enum ImportBatchStatus {
  PENDING // created, not yet processed
  COMPLETED // every row imported
  PARTIAL // some rows imported, some skipped/invalid (file was structurally valid)
  FAILED // file structurally invalid — nothing imported
}

model ImportBatch {
  id               String            @id @default(cuid())
  restaurantId     String
  // Nullable: a single file may carry rows for MULTIPLE branches (each row's
  // branch is resolved + stored on the ImportedSale). Set only when the whole
  // file resolved to one branch.
  branchId         String?
  fileName         String
  importedByUserId String
  rowCount         Int               @default(0)
  successCount     Int               @default(0)
  errorCount       Int               @default(0)
  status           ImportBatchStatus @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  sales ImportedSale[]

  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@index([restaurantId, createdAt])
  @@map("imported_sales_batches")
}

model ImportedSale {
  id              String   @id @default(cuid())
  restaurantId    String
  // Always set (resolved per row from the file's branch column, within the
  // importer's permitted scope). Stock attribution is N/A — these never deplete.
  branchId        String
  importBatchId   String
  // Timestamp of the historical sale (NOT createdAt). Reports bucket on this.
  occurredAt      DateTime
  itemDescription String
  // Nullable: linked to a catalog MenuItem ONLY if confidently matched. Plain
  // String (no FK) — an imported item may reference a since-deleted/unknown item.
  itemId          String?
  quantity        Int
  unitPriceAmount Int      @map("unit_price_amount")
  lineTotalAmount Int      @map("line_total_amount")
  paymentMethod   String?
  // Source transaction id. Used for idempotent re-import: a (restaurant,
  // externalReference) pair imports at most once. NULLs are distinct in
  // Postgres, so rows without a reference are never deduped.
  externalReference String?
  createdAt       DateTime @default(now())

  batch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, externalReference])
  @@index([restaurantId])
  @@index([restaurantId, branchId])
  @@index([restaurantId, occurredAt])
  @@index([restaurantId, branchId, occurredAt])
  @@index([importBatchId])
  @@map("imported_sales")
}

// ── Edge nodes (OFF-2) ───────────────────────────────────────────────────────
//   Cloud-side registry of provisioned on-prem EDGE hubs. Each node serves ONE
//   branch and authenticates to the cloud with a bearer node token (only its
//   sha256 hash is stored). The edge MIRRORS cloud ids — a node's snapshot is a
//   copy of one branch's slice, with the same ids throughout.
enum EdgeNodeStatus {
  ACTIVE
  REVOKED
}

// OFF-8 derived health for a provisioned hub. OK / SYNC_BACKLOG / SCHEMA_MISMATCH
// are STORED from heartbeats; OFFLINE is NEVER stored — it is derived on read
// from lastHeartbeatAt recency (a powered-off hub cannot report itself).
enum EdgeNodeHealthStatus {
  OK
  SYNC_BACKLOG
  SCHEMA_MISMATCH
  OFFLINE
}

model EdgeNode {
  id              String         @id @default(cuid())
  organizationId  String
  restaurantId    String
  branchId        String
  name            String
  // sha256(plaintext node token); the plaintext is shown once at creation.
  tokenHash       String         @unique
  status          EdgeNodeStatus @default(ACTIVE)
  lastSeenAt      DateTime?
  lastSnapshotAt  DateTime?
  // schemaVersion the node last reported / snapshotted at (OFF-8 uses it).
  schemaVersion   String?
  // ── OFF-8 telemetry (written by POST /edge-sync/heartbeat) ──────────────────
  // When the hub last sent a heartbeat. Online/offline is derived from this.
  lastHeartbeatAt    DateTime?
  // Pending edge→cloud outbox entries the hub last reported (sync backlog gauge).
  pendingOutboxCount Int?
  // The hub's reported application version (for the operator update flag).
  appVersion         String?
  // Last STORED health (OK | SYNC_BACKLOG | SCHEMA_MISMATCH). OFFLINE is derived.
  healthStatus       EdgeNodeHealthStatus?
  createdByUserId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([restaurantId, branchId])
  @@map("edge_nodes")
}

// Edge-LOCAL sync bookkeeping. The edge DB only ever holds its own node's row
// (one per node). Tracks the snapshot version applied + when. Absence of a row
// means the local DB is unseeded (bootstrap pulls a snapshot).
model EdgeSyncState {
  id              String    @id @default(cuid())
  nodeId          String    @unique
  snapshotVersion String?
  lastSyncedAt    DateTime?
  // OFF-3 downstream config sync: monotonic cursor (ISO timestamp) up to which
  // cloud config has been mirrored, when it last synced, and live connectivity.
  lastConfigCursor   String?
  lastConfigSyncedAt DateTime?
  online             Boolean   @default(false)
  // OFF-4 upstream operational sync: highest outbox edgeSeq acked by the cloud
  // and when the last push happened.
  lastPushedSeq      Int?
  lastPushAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("edge_sync_state")
}

// ── Operational outbox (OFF-4, EDGE-only) ────────────────────────────────────
//   Append-only, gapless, per-node stream of operational/stock writes. Every
//   operational write appends one entry capturing the record's CURRENT full
//   state, in the SAME transaction as the write. The push loop replays PENDING
//   entries to the cloud in edgeSeq order; idempotent by aggregate id. Config is
//   NEVER captured here (config flows DOWN only, OFF-3).
enum OutboxStatus {
  PENDING
  SYNCED
}

model OutboxEntry {
  id            String       @id @default(cuid())
  // ORDER | RESERVATION | STOCK_LAYER | STOCK_MOVEMENT | GOODS_RECEIPT | WRITE_OFF | PROCESS_RUN
  aggregateType String
  aggregateId   String
  // CREATE | UPSERT (informational; the cloud upserts-by-id to the sent state).
  op            String
  // The aggregate's full current state (cloud-mirrored ids), JSON-encoded.
  payload       Json
  // Monotonic, GAPLESS per node (assigned via EdgeOutboxCounter in the same tx).
  edgeSeq       Int          @unique
  status        OutboxStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  syncedAt      DateTime?

  @@index([status, edgeSeq])
  @@map("outbox_entries")
}

// Singleton (id = "edge") gapless sequence source for OutboxEntry.edgeSeq.
model EdgeOutboxCounter {
  id  String @id
  seq Int    @default(0)

  @@map("edge_outbox_counter")
}


// ── FISCAL-4: per-tenant e-HDM fiscal config + encrypted secrets ────────────
enum FiscalEnvironment {
  PROD
  TEST
}

/// Per-(restaurant, branch) SRC e-HDM configuration; feeds FiscalConfigPort.
/// clientCert/clientKey are AES-256-GCM CIPHERTEXT — the KEK lives OUTSIDE the DB
/// (FISCAL_SECRET_KEK / KMS, never a column). caRoot is the SRC public CA (shared,
/// from FISCAL_SRC_CA_PATH, not stored here). `.jks` is converted to PEM by ops
/// before upload; the runtime never parses `.jks`. Secrets are never returned by
/// any read model.
model FiscalConfig {
  id           String            @id @default(cuid())
  restaurantId String            @map("restaurant_id")
  branchId     String            @map("branch_id")
  crn          String
  cashierId    String            @map("cashier_id")
  environment  FiscalEnvironment @default(TEST)
  language     String            @default("hy")
  active       Boolean           @default(false)

  // ENVELOPE encryption. cert/key (PEM) are encrypted with a per-tenant random
  // DEK; the DEK is wrapped by the master KEK (FISCAL_MASTER_KEK / KMS — NEVER in
  // the DB). All AES-256-GCM (cipher + iv + auth tag). KEK rotation re-wraps the
  // DEK only (no cert re-encryption); one compromised cert never implies others.
  certCipher  Bytes @map("cert_cipher")
  certIv      Bytes @map("cert_iv")
  certAuthTag Bytes @map("cert_auth_tag")
  keyCipher   Bytes @map("key_cipher")
  keyIv       Bytes @map("key_iv")
  keyAuthTag  Bytes @map("key_auth_tag")
  // The per-tenant DEK, wrapped by the master KEK.
  dekCipher   Bytes @map("dek_cipher")
  dekIv       Bytes @map("dek_iv")
  dekAuthTag  Bytes @map("dek_auth_tag")
  // Which master-KEK version wrapped the DEK (for rotation / re-wrap).
  kekVersion  Int   @default(1) @map("kek_version")

  lastCheckConnectionAt DateTime? @map("last_check_connection_at")
  lastCheckConnectionOk Boolean?  @map("last_check_connection_ok")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  departments FiscalDepartment[]

  @@unique([restaurantId, branchId])
  @@index([restaurantId])
  @@map("fiscal_configs")
}

/// Per-tenant department map: SRC `dep` code -> tax regime. Homes the deferred
/// `dep`; the adapter builds departmentMap from these rows. Values come from the
/// tenant's SRC registration.
model FiscalDepartment {
  id             String  @id @default(cuid())
  fiscalConfigId String  @map("fiscal_config_id")
  dep            String
  taxRegime      String  @map("tax_regime")
  label          String?

  config FiscalConfig @relation(fields: [fiscalConfigId], references: [id], onDelete: Cascade)

  @@unique([fiscalConfigId, dep])
  @@index([fiscalConfigId])
  @@map("fiscal_departments")
}
