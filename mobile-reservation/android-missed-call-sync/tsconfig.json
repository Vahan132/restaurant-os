{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "types": ["jest", "react", "node"]
  },
  "include": ["**/*.ts", "**/*.tsx", "plugins/**/*.js"],
  "exclude": ["node_modules"]
}
