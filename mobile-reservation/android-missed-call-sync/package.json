{
  "name": "android-missed-call-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Android companion app that reports missed calls to the restaurant-os admin missed-call inbox (R-AND-1).",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "tsc --noEmit",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-dev-client": "~4.0.0",
    "expo-secure-store": "~13.0.0",
    "expo-status-bar": "~1.12.0",
    "expo-intent-launcher": "~11.0.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-call-log": "^3.0.0",
    "@notifee/react-native": "^9.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.79",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.0",
    "ts-jest": "^29.1.5",
    "typescript": "~5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
