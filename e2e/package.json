{
  "name": "restaurant-os-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-app E2E tests for Restaurant OS.",
  "scripts": {
    "test": "playwright test",
    "e2e": "playwright test",
    "e2e:health": "playwright test --project=health",
    "e2e:api": "playwright test --project=api",
    "e2e:website": "playwright test --project=website",
    "e2e:admin": "playwright test --project=admin",
    "e2e:pos": "playwright test --project=pos",
    "e2e:pos-requests": "playwright test --project=pos tests/pos/pos-requests.spec.ts",
    "e2e:reject-request": "playwright test --project=pos tests/pos/reject-request.spec.ts",
    "e2e:checkout": "playwright test --project=pos tests/pos/checkout.spec.ts",
    "e2e:kds": "playwright test --project=kds",
    "e2e:kds-ticket": "playwright test --project=kds tests/kds/kds-ticket.spec.ts",
    "e2e:kds-station-filtering": "playwright test --project=kds tests/kds/kds-station-filtering.spec.ts",
    "e2e:customer": "playwright test --project=customer",
    "e2e:customer-order": "playwright test --project=customer tests/customer/customer-order.spec.ts",
    "e2e:mobile": "playwright test --project=mobile-reservation",
    "e2e:all": "playwright test --project=all-flow",
    "test:headed": "playwright test --headed",
    "test:debug": "PWDEBUG=1 playwright test",
    "report": "playwright show-report artifacts/html",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
