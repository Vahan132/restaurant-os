# Base URL of the Restaurant OS backend (reached over HTTP — this is a separate app).
# Path-based prod example: https://msi.tail8514ca.ts.net/res/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Realtime (socket.io). Connect to the bare host; the client `path` option is
# overridden so nginx can map /res/socket.io/ -> the backend's default /socket.io/.
NEXT_PUBLIC_SOCKET_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_PATH=/socket.io

# NOTE: The above are the CLOUD defaults. A terminal can instead target a Local
# hub on the LAN — that's a per-device runtime setting (stored under the
# `pos-endpoint` localStorage key via Device settings in the app), NOT an env
# var. When a device targets its hub, ALL REST + realtime traffic points at the
# hub's base URL and these cloud values are ignored. The app never falls back to
# cloud for a hub-managed branch (single writer — see OFF-6a §4).
