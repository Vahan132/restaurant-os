# Base URL of the RES backend HTTP API. Codegen + axios both read this.
# Path-based prod example: https://msi.tail8514ca.ts.net/res/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Realtime (socket.io) host. Connect to the bare host; the client `path` option
# is overridden so nginx can map /res/socket.io/ -> the backend's /socket.io/.
# Falls back to NEXT_PUBLIC_API_BASE_URL's origin if unset.
NEXT_PUBLIC_SOCKET_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_PATH=/socket.io
