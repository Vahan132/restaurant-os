# Base URL of the Restaurant OS backend API (reached over HTTP).
# Path-based prod example: https://msi.tail8514ca.ts.net/res/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Realtime (socket.io). Connect to the bare host; the client `path` option is
# overridden so nginx can map /res/socket.io/ -> the backend's default /socket.io/.
NEXT_PUBLIC_SOCKET_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_PATH=/socket.io

# Source for `pnpm generate:api`. Either a local file (default) or the live
# Nest swagger JSON endpoint, e.g. http://localhost:3001/docs-json
ORVAL_INPUT=./openapi.json

# Customer / QR app URL template ({slug} and {qr} are substituted).
# Path-based prod example: https://msi.tail8514ca.ts.net/res/m/{slug}?qr={qr}
NEXT_PUBLIC_CUSTOMER_URL_TEMPLATE=http://localhost:3002/{slug}?qr={qr}
