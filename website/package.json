{
  "name": "restaurant-os-web",
  "version": "0.1.0",
  "private": true,
  "description": "Public marketing + documentation website for Restaurant OS.",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "generate:api": "orval --config orval.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,mdx,css}\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.1.6",
    "@tanstack/react-query": "^5.100.14",
    "axios": "^1.16.1",
    "next": "^15.1.6",
    "next-intl": "^4.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.77.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "sonner": "^2.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "eslint-config-prettier": "^9.1.0",
    "orval": "^7.13.2",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
