# Restaurant OS — website (W1 marketing + W2 account) environment.
# Copy to .env.local and adjust. All client-exposed vars must be NEXT_PUBLIC_*.

# Base URL of the Restaurant OS API (the backend that serves /public, /auth, /account).
# Path-based prod example: https://msi.tail8514ca.ts.net/res/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Platform apps the owner is linked to from the account hub (path form in prod).
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_POS_URL=http://localhost:3002
NEXT_PUBLIC_KDS_URL=http://localhost:3003

# Customer QR-menu URL template. {slug} = restaurant slug, {qr} = table/QR code.
# The signup "subdomain" step previews the resulting URL from this template.
# Path-based prod example: https://msi.tail8514ca.ts.net/res/m/{slug}?qr={qr}
NEXT_PUBLIC_CUSTOMER_URL_TEMPLATE=http://{slug}.localhost:3004/{qr}

# Realtime (socket.io) host — unused by the website, kept for parity with the
# other apps. Connect to the bare host and override the client `path`.
NEXT_PUBLIC_SOCKET_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_PATH=/socket.io
