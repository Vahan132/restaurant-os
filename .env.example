# Restaurant OS — full-stack compose env. Copy to .env (gitignored) and fill in.
# `docker compose up --build` reads this. LOCAL values shown; ⚑ = change for staging.

# --- Postgres (same-box container) ---
POSTGRES_USER=restaurantos
POSTGRES_PASSWORD=restaurantos            # ⚑ strong value on staging
POSTGRES_DB=restaurantos

# --- API runtime ---
NODE_ENV=development                      # ⚑ staging: production (then STORAGE_DRIVER must be r2)
CORS_ORIGINS=http://localhost             # ⚑ staging: http://<droplet-ip>
PLATFORM_ROOT_DOMAIN=localhost            # ⚑ staging: <droplet-ip> (path/header tenant fallback still applies)
STORAGE_DRIVER=dev                        # ⚑ staging: r2 (+ the R2_* below); dev is refused when NODE_ENV=production
HTTP_PORT=80                              # host port the proxy publishes

# --- JWT secrets (min 16 chars each; generate unique random values) ---
JWT_ACCESS_SECRET=change-me-access-0001
JWT_REFRESH_SECRET=change-me-refresh-0001
PLATFORM_JWT_ACCESS_SECRET=change-me-platform-access-0001
PLATFORM_JWT_REFRESH_SECRET=change-me-platform-refresh-0001
CONSUMER_JWT_ACCESS_SECRET=change-me-consumer-access-0001
CONSUMER_JWT_REFRESH_SECRET=change-me-consumer-refresh-0001

# --- Media storage (only required when STORAGE_DRIVER=r2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Consumer SMS OTP (optional; blank disables SMS) ---
SMS_NIKITA_URL=
SMS_NIKITA_USER=
SMS_NIKITA_PASS=
SMS_NIKITA_ORIGINATOR=

# NOTE: the frontend NEXT_PUBLIC_* values are NOT here — they are SAME-ORIGIN
# RELATIVE constants baked at image build (/res/api, /res/socket.io) via compose
# build-args, so no per-environment frontend rebuild is needed.

# --- Deploy channel (DEPLOY-3) ---
IMAGE_TAG=develop            # moving channel tag; pin sha-<short> to roll back, then `docker compose up -d`
COMPOSE_PROFILES=bundled-proxy   # starts the bundled nginx on :80. Leave EMPTY if a host nginx fronts the app ports.
