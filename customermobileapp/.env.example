# Base URL of the Restaurant OS backend the consumer app talks to.
# Point this at your local backend (e.g. via Tailscale/Nginx) during dev.
# No trailing slash. Example: https://api.dev.example.ts.net
EXPO_PUBLIC_API_BASE_URL=

# --- Spec sync (used by `npm run sync:spec`; not needed at app runtime) ---
# Mode A: copy the backend's generated spec from a local path.
# Defaults to the backend's spec location if unset (see scripts/sync-spec.mjs).
OPENAPI_SPEC_PATH=

# Mode B: fetch the spec from a running backend URL (takes precedence if set).
# Example: https://api.dev.example.ts.net/openapi.json
OPENAPI_SPEC_URL=

# --- Consumer sign-in (CX-APP-2) ---
# Google OAuth client IDs (Google Cloud → Credentials). Leave blank to test
# OTP/Apple only — the Google button then errors gracefully.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Apple sign-in needs no client secret in the app (handled by the native module +
# the backend's APPLE_CLIENT_IDS). iOS dev build only.
